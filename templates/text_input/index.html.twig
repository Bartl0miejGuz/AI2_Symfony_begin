{% extends 'base.html.twig' %}

{% block title %}Text Submission Form{% endblock %}

{% block body %}
    <h1>Text Submission Form</h1>

    {{ form_start(form) }}
    {{ form_widget(form) }}
    <button type="submit">Submit</button>
    {{ form_end(form) }}

    {% set submittedText = app.flashes('text_input')|first %}

    {% if submittedText is not empty %}
        <h2>Submitted Text</h2>
        <p>{{ submittedText }}</p>
        <p>{{ submittedText|raw }}</p>
    {% endif %}
{% endblock %}
